DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=
# Prefer `grok login` on the host (SuperGrok subscription). Console key is optional.
# XAI_API_KEY=
GROK_MODEL=default
# GROK_API_KEY=          # alias for XAI_API_KEY; pay-per-token fallback if not logged in
# GROK_BIN=grok
# GROK_CWD=/path/to/project   # default: ./workspace
# GROK_ALWAYS_APPROVE=true
# GROK_SANDBOX=workspace      # workspace | read-only | strict | off
# GROK_TIMEOUT_MS=600000
# GROK_ISOLATE=true
# GROK_ISOLATE_CLONE=false      # true clones GROK_REPO_URL on every new conversation (slow)
# GROK_ISOLATE_IMAGE=sroc-agent:latest
# GROK_REPO_URL=https://github.com/bopke/sroc.git
# GITHUB_TOKEN=                 # required for clone/push/gh pr create inside containers
# GIT_USER_NAME=sroc bot
# GIT_USER_EMAIL=sroc-bot@users.noreply.github.com
# GROK_ISOLATE_MEMORY=1g
# GROK_ISOLATE_CPUS=1
# GROK_EFFORT=low
# GROK_NO_PLAN=true
# GROK_NO_SUBAGENTS=true
# VALUT_CHANNEL_ID=      # kanał na który lądują posty z 3x gold reaction
